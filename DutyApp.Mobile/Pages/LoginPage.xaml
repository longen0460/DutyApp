<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DutyApp.Mobile.Pages.LoginPage"
             BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundDark}, Dark={StaticResource BackgroundDark}}"
             Title="Вход">

    <Grid>
        <BoxView HeightRequest="200" VerticalOptions="Start" Color="{StaticResource Primary}"/>

        <Border Margin="30" VerticalOptions="Center" StrokeShape="RoundRectangle 20">
            <VerticalStackLayout Padding="20" Spacing="20">
                <Label Text="Вход в систему" FontSize="28" FontAttributes="Bold" HorizontalOptions="Center" 
                       TextColor="{StaticResource TextLight}"/>

                <Label Text="Управление дежурствами" FontSize="14" TextColor="{StaticResource TextMuted}" HorizontalOptions="Center"/>

                <Border StrokeShape="RoundRectangle 10" BackgroundColor="#2D2D2D" Padding="10">
                    <Entry x:Name="LoginEntry" Placeholder="Логин"/>
                </Border>

                <Border StrokeShape="RoundRectangle 10" BackgroundColor="#2D2D2D" Padding="10">
                    <Entry x:Name="PasswordEntry" Placeholder="Пароль" IsPassword="True"/>
                </Border>

                <Button Text="Войти" Clicked="OnLoginClicked" Margin="0,10,0,0"/>

                <Label x:Name="ErrorLabel" TextColor="{StaticResource Danger}" HorizontalOptions="Center" FontAttributes="Bold"/>
                <ActivityIndicator x:Name="LoadingIndicator" IsRunning="False" IsVisible="False" Color="{StaticResource Primary}"/>
            </VerticalStackLayout>
        </Border>
    </Grid>
</ContentPage>