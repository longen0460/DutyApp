<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DutyApp.Mobile.Pages.BalancePage"
             BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundDark}, Dark={StaticResource BackgroundDark}}"
             Title="Дежурства">

    <Grid RowDefinitions="Auto,Auto,*,Auto" Padding="15" RowSpacing="10">

        <Button Grid.Row="0" Text="🎲 Выбрать дежурных на сегодня" 
                Clicked="OnAssignClicked" BackgroundColor="#28a745" HeightRequest="60" FontSize="16"/>

        <Border Grid.Row="1" StrokeShape="RoundRectangle 12" BackgroundColor="{StaticResource SurfaceDark}" Padding="10">
            <VerticalStackLayout>
                <Label Text="Сегодня дежурят:" FontAttributes="Bold" TextColor="{StaticResource TextLight}"/>
                <Label x:Name="TodayLabel" TextColor="{StaticResource TextMuted}" FontSize="14"/>
            </VerticalStackLayout>
        </Border>

        <CollectionView Grid.Row="2" x:Name="ListView">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border StrokeShape="RoundRectangle 12" Margin="0,5" Padding="15">
                        <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="10">
                            <Button Grid.Column="0" Text="👁" BackgroundColor="Transparent" WidthRequest="40"
                                    Clicked="OnToggleAvailability" CommandParameter="{Binding Id}" FontSize="20"/>
                            <Label Grid.Column="1" Text="{Binding FullName}" FontSize="16" VerticalOptions="Center" 
                                   TextColor="{StaticResource TextLight}"/>
                            <Border Grid.Column="2" BackgroundColor="{StaticResource Primary}" StrokeShape="RoundRectangle 15" Padding="12,5">
                                <Label Text="{Binding Count}" TextColor="White" FontAttributes="Bold"/>
                            </Border>
                            <Button Grid.Column="3" Text="📜" BackgroundColor="Transparent" WidthRequest="40"
                                    Clicked="OnHistoryClicked" CommandParameter="{Binding Id}" FontSize="20"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ActivityIndicator Grid.Row="3" x:Name="LoadingIndicator" IsRunning="False" IsVisible="False" Color="{StaticResource Primary}"/>
    </Grid>
</ContentPage>