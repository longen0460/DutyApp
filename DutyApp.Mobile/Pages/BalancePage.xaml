<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DutyApp.Mobile.Pages.BalancePage"
             BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundDark}, Dark={StaticResource BackgroundDark}}"
             Title="Баланс нагрузки">
    <Grid RowDefinitions="*,Auto" Padding="15">
        <CollectionView Grid.Row="0" x:Name="ListView">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border StrokeShape="RoundRectangle 12" Margin="0,5" Padding="15">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{Binding FullName}" FontSize="16" VerticalOptions="Center" TextColor="{StaticResource TextLight}"/>
                            <Border Grid.Column="1" BackgroundColor="{StaticResource Primary}" StrokeShape="RoundRectangle 15" Padding="12,5">
                                <Label Text="{Binding Count}" TextColor="White" FontAttributes="Bold"/>
                            </Border>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ActivityIndicator Grid.Row="1" x:Name="LoadingIndicator" IsRunning="False" IsVisible="False" Color="{StaticResource Primary}"/>
    </Grid>
</ContentPage>