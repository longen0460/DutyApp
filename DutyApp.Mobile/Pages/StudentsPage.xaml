<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DutyApp.Mobile.Pages.StudentsPage"
             BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundDark}, Dark={StaticResource BackgroundDark}}"
             Title="Список группы">

    <ContentPage.ToolbarItems>
        <!-- Иконка темы -->
        <ToolbarItem x:Name="ThemeIcon" Text="🌙" Clicked="OnThemeToggle" Priority="0"/>
        <ToolbarItem Text="Обновить" Clicked="OnRefresh" Priority="1"/>
        <ToolbarItem Text="Меню" Clicked="OnMenu" Priority="2"/>
    </ContentPage.ToolbarItems>

    <Grid RowDefinitions="Auto,*,Auto" Padding="15" RowSpacing="10">

        <Border Grid.Row="0" x:Name="AddPanel" StrokeShape="RoundRectangle 10" BackgroundColor="#2D2D2D">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                <Entry x:Name="NameEntry" Placeholder="ФИО студента" Grid.Column="0"/>
                <Button Grid.Column="1" Text="+" Clicked="OnAddClicked" WidthRequest="50" HeightRequest="50" CornerRadius="10"/>
            </Grid>
        </Border>

        <CollectionView Grid.Row="1" x:Name="ListView" Margin="0,10,0,0">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border StrokeShape="RoundRectangle 12" Margin="0,5" Padding="15">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="{Binding FullName}" VerticalOptions="Center" FontSize="16" 
                                   TextColor="{StaticResource TextLight}"/>
                            <Button Grid.Column="1" Text="Удалить" TextColor="White" BackgroundColor="{StaticResource Danger}" 
                                    CornerRadius="8" Clicked="OnDeleteClicked" CommandParameter="{Binding Id}" 
                                    HeightRequest="35" FontSize="12" Padding="10,0"/>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <ActivityIndicator Grid.Row="2" x:Name="LoadingIndicator" IsRunning="False" IsVisible="False" Color="{StaticResource Primary}"/>
    </Grid>
</ContentPage>