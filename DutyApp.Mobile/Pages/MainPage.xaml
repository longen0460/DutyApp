<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="DutyApp.Mobile.Pages.MainPage"
             BackgroundColor="{AppThemeBinding Light={StaticResource BackgroundDark}, Dark={StaticResource BackgroundDark}}"
             Title="Главная">

    <ContentPage.ToolbarItems>
        <ToolbarItem x:Name="ThemeIcon" Text="🌙" Clicked="OnThemeToggle" Order="Primary" Priority="0"/>
        <ToolbarItem Text="Выйти" Clicked="OnLogout" Order="Primary" Priority="1"/>
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="15">
            <Label x:Name="WelcomeLabel" FontSize="24" FontAttributes="Bold" 
                   TextColor="{StaticResource TextLight}" Margin="0,10,0,10"/>

            <Border StrokeShape="RoundRectangle 15">
                <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="10" RowSpacing="10">
                    <Button Grid.Row="0" Grid.Column="0" Text="👥 Группа" Clicked="OnStudentsClicked" HeightRequest="80" FontSize="18"/>
                    <Button Grid.Row="0" Grid.Column="1" Text="📅 Дежурства" Clicked="OnBalanceClicked" HeightRequest="80" FontSize="18"/>
                    <Button Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="📜 История" Clicked="OnHistoryClicked" HeightRequest="80" FontSize="18"/>
                    <Button Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Text="👤 Пользователи" Clicked="OnUsersClicked" HeightRequest="80" FontSize="18" BackgroundColor="#28a745"/>
                </Grid>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>